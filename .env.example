# Copy to .env.local and fill in. Never commit .env.local.
DATABASE_URL=postgresql://lostfound:<password>@localhost:5432/lostfound
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=lostfound
# any long random string, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=<random-secret>
